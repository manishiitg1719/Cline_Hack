# ---------------- FarmGuard backend configuration ----------------
# Copy this file to `.env` and fill in what you have.
# Every key is OPTIONAL: when a key is missing the feature runs in FALLBACK mode.

# Security (change in production)
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_EXPIRE_HOURS=72

# Database (SQLite by default)
DATABASE_URL=sqlite:///./farmguard.db

# Frontend origin allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Village Disease Radar: run outbreak analysis every N minutes (0 = only via "Run now" button)
RADAR_INTERVAL_MINUTES=60

# Force every provider into FALLBACK mode (useful for demos / saving credits)
FORCE_FALLBACK=false

# ---- AI / LLM (any OpenAI-compatible endpoint: OpenRouter, OpenAI, Groq, etc.) ----
LLM_ENABLED=false
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_DAILY_CALL_LIMIT=200

# ---- Free, no-key services (on by default) ----
OPEN_METEO_ENABLED=true
SOILGRIDS_ENABLED=true

# ---- Optional keyed services ----
DATA_GOV_API_KEY=
OPENWEATHER_API_KEY=
# Satellite field health: Sentinel-2 via Microsoft Planetary Computer (free, no key)
SATELLITE_ENABLED=true
